###############################################
# 0) CREATE TWO BOOKINGS FIRST
###############################################

### Create Booking A (Requester)
POST http://localhost:5000/api/bookings
Content-Type: application/json

{
  "areaId": 1,
  "workcellId": 10,
  "vendorId": 5,
  "serialNumber": "SN-A001",
  "startDateTime": "2025-11-30T02:00:00.000Z",
  "endDateTime": "2025-11-30T04:00:00.000Z",
  "createdByUserId": 1
}

### Create Booking B (Receiver)
POST http://localhost:5000/api/bookings
Content-Type: application/json

{
  "areaId": 2,
  "workcellId": 12,
  "vendorId": 7,
  "serialNumber": "SN-B001",
  "startDateTime": "2025-11-30T06:00:00.000Z",
  "endDateTime": "2025-11-30T08:00:00.000Z",
  "createdByUserId": 2
}

###############################################
# 1) CREATE SWAP REQUEST (NEUTRAL)
###############################################

### Request: A (from) wants B (to)'s slot
POST http://localhost:5000/api/booking-swap/requests/existing
Content-Type: application/json

{
  "fromBookingId": 101,
  "toBookingId": 102,
  "requestedByUserId": 1,
  "expiresInMinutes": 60
}

# NOTE:
#  - Adjust booking ids 101 / 102 to real IDs returned from step 0.
#  - Response will include bookingSwapReqId. Use that below.


###############################################
# 2) APPROVE AS: SwapSlots
###############################################

### Approve requestId = 1 with decisionType = SwapSlots
POST http://localhost:5000/api/booking-swap/requests/1/approve
Content-Type: application/json

{
  "approverUserId": 2,
  "approverUserName": "NTID_APPROVER",
  "decisionType": "SwapSlots",
  "reason": "Normal slot swap"
}

###############################################
# 3) APPROVE AS: GiveSlot_CancelReceiver
###############################################

### Approve requestId = 2 with decisionType = GiveSlot_CancelReceiver
POST http://localhost:5000/api/booking-swap/requests/2/approve
Content-Type: application/json

{
  "approverUserId": 2,
  "approverUserName": "NTID_APPROVER",
  "decisionType": "GiveSlot_CancelReceiver",
  "reason": "Receiver does not need the slot anymore"
}

###############################################
# 4) APPROVE AS: GiveSlot_RescheduleReceiver
###############################################

### Approve requestId = 3 with decisionType = GiveSlot_RescheduleReceiver
POST http://localhost:5000/api/booking-swap/requests/3/approve
Content-Type: application/json

{
  "approverUserId": 2,
  "approverUserName": "NTID_APPROVER",
  "decisionType": "GiveSlot_RescheduleReceiver",
  "receiverNewSlotAreaId": 5,
  "receiverNewSlotStart": "2025-11-30T03:00:00.000Z",
  "receiverNewSlotEnd": "2025-11-30T05:00:00.000Z",
  "reason": "Receiver will move to a later slot"
}

###############################################
# 5) REJECT SWAP REQUEST
###############################################

### Reject requestId = 4
POST http://localhost:5000/api/booking-swap/requests/4/reject
Content-Type: application/json

{
  "approverUserId": 2,
  "approverUserName": "NTID_APPROVER",
  "reason": "Slot not suitable"
}
