### BASE URL
@baseUrl = http://localhost:5000/api



##############################################################
# 1. CREATE BOOKING A (Job + Booking + Stage)
##############################################################
POST {{baseUrl}}/jobs-with-booking
Content-Type: application/json

{
  "serialNumber": "SN-TEST-001",
  "model": "TEST-MODEL-A",
  "workcellId": 1,
  "vendorId": 1,
  "areaId": 1,
  "startDateTime": "2025-12-01T09:00:00Z",
  "endDateTime": "2025-12-01T10:00:00Z"
}



##############################################################
# 2. CREATE BOOKING B (Job + Booking + Stage)
##############################################################
POST {{baseUrl}}/jobs-with-booking
Content-Type: application/json

{
  "serialNumber": "SN-TEST-002",
  "model": "TEST-MODEL-B",
  "workcellId": 2,
  "vendorId": 1,
  "areaId": 2,
  "startDateTime": "2025-12-01T11:00:00Z",
  "endDateTime": "2025-12-01T12:00:00Z"
}



##############################################################
# ⚠️  IMPORTANT
# After running the above, check the DB:
# SELECT Booking_Id FROM core.Booking ORDER BY Booking_Id DESC;
# Assume they are:
# Booking A = 1
# Booking B = 2
##############################################################



##############################################################
# 3. CREATE SWAP REQUEST  (A → B)
##############################################################
POST {{baseUrl}}/booking-swap/request
Content-Type: application/json

{
  "fromBookingId": 1,
  "toBookingId": 2,
  "requestedByUserId": 10,
  "expiresInMinutes": 60
}



##############################################################
# 4. APPROVE AS RECEIVER BOOKING B (type SwapSlots)
##############################################################
POST {{baseUrl}}/booking-swap/request/approve
Content-Type: application/json

{
  "swapReqId": 1,
  "approverUserId": 20,
  "approverUsername": "faiz",
  "decisionType": "SwapSlots",
  "decisionReason": "Testing SwapSlots"
}



##############################################################
# 5. CHECK SWAP HISTORY FOR BOOKING 1
##############################################################
GET {{baseUrl}}/booking-swap/history/booking/1



##############################################################
# 6. CHECK SWAP HISTORY FOR BOOKING 2
##############################################################
GET {{baseUrl}}/booking-swap/history/booking/2



##############################################################
# 7. CHECK REQUESTS FOR BOOKING 1
##############################################################
GET {{baseUrl}}/booking-swap/request/booking/1



##############################################################
# 8. CHECK REQUESTS FOR USER 20  (receiver)
##############################################################
GET {{baseUrl}}/booking-swap/request/user/20
